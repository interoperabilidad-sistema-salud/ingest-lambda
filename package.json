{
  "name": "ingest-lambda",
  "version": "1.0.0",
  "description": "Ingest Lambda for SGSSS Federated Interoperability System",
  "main": "src/handlers/ingest.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src/ tests/",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/ --coverage",
    "coverage:check": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "security:check": "grep -rn 'AKIA\\|aws_secret\\|password\\s*=' --include='*.js' src/ && exit 1 || echo 'OK'",
    "build": "bash scripts/package-lambda.sh"
  },
  "engines": {
    "node": ">=22.x"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0"
  }
}
